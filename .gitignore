# Compiled outputs
NSBEdit.res

# Generated header
version.h
curver.txt

# Distribution zips
zip/

# Machine-specific workspace file (absolute paths)
*.code-workspace

# Secrets — never commit API keys or the local profile database.
# The Ollama cloud API key is entered in-app and stored ONLY in the per-user
# profile DB under %APPDATA%\NSBEdit\nsbedit.db (never in the repo or the zip).
*api*key*.txt
*API*KEY*.txt
*apikey*
*.key
nsbedit.db
*.db

# Build artifacts — object files, executables, and the build log are produced
# by makeit.bat and should never be committed.
*.o
*.exe
makeit.log

# Generated cmark-gfm headers (produced from the *.in templates at build time)
third_party/cmark-gfm/src/config.h
third_party/cmark-gfm/src/cmark-gfm_export.h
third_party/cmark-gfm/src/cmark-gfm_version.h

# Scratch / debug files
ai.txt
test.txt
start.txt
AI_attach.txt
ToDo.render.AI
